# Connexion MongoDB Atlas (obligatoire)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/capucine

# Port d'écoute (optionnel, défaut 3001)
PORT=3001

# Token partagé pour protéger /entries.
# Si vide ou absent, l'API reste ouverte (compat). Recommandé en prod.
# Côté client, ouvrir l'app une fois avec : https://app.tld/#token=VALEUR
# La valeur sera mémorisée dans le navigateur.
CAPUCINE_TOKEN=

# Origine autorisée pour CORS (ex: https://capucine.example.com)
# Si vide, CORS reste ouvert (compat).
ALLOWED_ORIGIN=

# Bisou à Bibi via ntfy.sh (gratuit, sans compte).
# Bibi installe l'app ntfy sur son téléphone, s'abonne au topic ci-dessous,
# et reçoit une notif chaque fois que Capucine tape sur "Envoyer un bisou".
# Choisis un topic long et secret (32+ caractères aléatoires).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
